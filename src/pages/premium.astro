---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
const upgrade = Astro.url.searchParams.get('upgrade') === '1';

const STRIPE_PREMIUM = 'https://buy.stripe.com/8x2fZh9eQ3yQ4Vs6kweQM04';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: "Est-ce que mon diagnostic influence l'attribution du prêt ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Non. DossierPrêt est un outil d'analyse pédagogique indépendant. Il n'a aucun lien avec les banques et n'apparaît pas dans les bases de données bancaires.",
      },
    },
    {
      '@type': 'Question',
      name: 'Est-ce que vous voyez mes informations bancaires ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Non. Vous saisissez vous-même vos données et elles ne sont pas stockées ni transmises. Votre diagnostic reste entièrement confidentiel.",
      },
    },
    {
      '@type': 'Question',
      name: 'Mon résultat est-il garanti ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Non. Il s'agit d'une simulation basée sur des critères standards. Les décisions bancaires réelles dépendent de nombreux autres facteurs propres à chaque établissement.",
      },
    },
    {
      '@type': 'Question',
      name: 'Puis-je annuler mon abonnement ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Le plan Premium est un accès unique par rapport. Il n'y a pas d'abonnement pour ce plan. Le plan Pro peut être annulé à tout moment.",
      },
    },
    {
      '@type': 'Question',
      name: "Quelle est la différence avec un simulateur de prêt ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Un simulateur de prêt calcule des mensualités. DossierPrêt analyse votre profil bancaire pour identifier les risques de refus — pas le montant que vous pouvez emprunter.",
      },
    },
  ],
};
---

<BaseLayout
  title="Conseils personnalisés pour votre prêt immobilier — DossierPrêt Premium"
  description="Obtenez un plan d'action personnalisé pour votre dossier de prêt immobilier. Identifiez ce qui peut bloquer votre prêt et comment y remédier. Accès immédiat, à partir de 16€."
  schema={faqSchema}
>
  <div class="min-h-screen flex flex-col">
    <Navbar currentPath="/premium" />

    <!-- Bandeau upgrade (affiché si redirigé depuis /diagnostic) -->
    {upgrade && (
      <div class="bg-amber-50 dark:bg-amber-900/20 border-b border-amber-100 dark:border-amber-800/50">
        <div class="container-main py-3 flex items-center gap-3">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-amber-600 dark:text-amber-400 flex-shrink-0"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <p class="text-sm text-amber-800 dark:text-amber-300">
            <strong>Accès Premium requis</strong> — choisissez un plan ci-dessous pour accéder au diagnostic complet.
          </p>
        </div>
      </div>
    )}

    <!-- Hero -->
    <section class="pt-16 pb-12 bg-gradient-to-b from-white dark:from-slate-900 to-gray-50/50 dark:to-slate-800/50 transition-colors duration-200">
      <div class="container-main text-center">
        <div class="inline-flex items-center gap-2 badge badge-dark mb-5">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="white"/></svg>
          Analyse complète · Plan d'action
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white tracking-tight mb-4">
          Sachez exactement pourquoi<br class="hidden sm:block" /> votre banque pourrait refuser votre prêt
        </h1>
        <p class="text-lg text-gray-500 dark:text-slate-400 max-w-xl mx-auto">
          Un rapport détaillé avec les blocages identifiés et les actions concrètes pour améliorer votre dossier — avant de déposer.
        </p>
      </div>
    </section>

    <!-- Pricing — one-shot -->
    <section class="py-16 bg-gray-50 dark:bg-slate-800/50 transition-colors duration-200">
      <div class="container-main flex justify-center">
        <div class="relative w-full max-w-sm">
          <!-- Badge recommandé -->
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
            <span class="inline-flex items-center gap-1 px-3 py-1 bg-amber-400 text-amber-900 text-xs font-bold rounded-full shadow-sm whitespace-nowrap">
              ✦ Accès complet
            </span>
          </div>

          <div class="bg-gray-900 text-white rounded-2xl shadow-2xl ring-1 ring-gray-800 p-8 pt-10 flex flex-col items-center text-center">
            <!-- Prix -->
            <div class="flex items-end gap-1.5 mb-1">
              <span class="text-5xl font-black leading-none">19€</span>
              <span class="text-base text-white/40 mb-1">accès unique</span>
            </div>
            <p class="text-sm text-white/50 mb-8">Un seul paiement · Pas d'abonnement</p>

            <!-- Features -->
            <ul class="space-y-3 w-full text-left mb-8">
              {[
                'Analyse détaillée de chaque critère bancaire',
                'Les blocages identifiés et classés par priorité',
                "Plan d'action concret pour corriger votre dossier",
                'Simulations selon vos scénarios',
                'Rapport PDF téléchargeable',
                'Résultat confidentiel — aucune donnée partagée',
              ].map(feature => (
                <li class="flex items-start gap-2.5 text-sm text-white/80">
                  <svg class="flex-shrink-0 mt-0.5 text-white" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            <!-- CTA -->
            <a
              href={STRIPE_PREMIUM}
              class="w-full text-center py-3.5 px-4 rounded-xl text-sm font-semibold bg-white text-gray-900 hover:bg-gray-100 transition-colors"
            >
              Obtenir mon analyse complète
            </a>

            <p class="text-xs text-white/30 mt-4">Paiement sécurisé via Stripe</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What's included in Premium -->
    <section class="py-16 bg-white dark:bg-slate-900 border-t border-gray-100 dark:border-slate-800 transition-colors duration-200">
      <div class="container-main">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Ce que vous obtenez avec le Premium</h2>
          <p class="text-gray-500 dark:text-slate-400 mt-2 max-w-xl mx-auto">
            Tout ce qu'il faut pour déposer votre dossier de prêt immobilier en sachant exactement où vous en êtes.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            {
              icon: '📊',
              title: 'Analyse ligne par ligne de votre profil',
              desc: 'Chaque paramètre évalué en détail : taux d\'endettement, apport, stabilité des revenus, reste à vivre — avec les points qui peuvent bloquer votre dossier.',
            },
            {
              icon: '🎯',
              title: 'On vous dit exactement ce qui peut bloquer',
              desc: 'Les signaux négatifs les plus impactants sont mis en avant et classés par priorité. Vous savez immédiatement sur quoi agir en premier.',
            },
            {
              icon: '📋',
              title: 'Un plan d\'action clair et priorisé',
              desc: 'Des recommandations concrètes et actionnables pour corriger votre profil avant de soumettre votre demande de prêt immobilier.',
            },
            {
              icon: '📈',
              title: 'Simulations selon votre situation',
              desc: 'Projections et scénarios optimisés selon différentes configurations : durée du prêt, montant d\'apport, remboursement anticipé.',
            },
            {
              icon: '🔒',
              title: 'Vos données restent les vôtres',
              desc: 'Aucune donnée transmise à des tiers. Votre analyse reste strictement privée — on ne vend rien, on ne partage rien.',
            },
            {
              icon: '⚡',
              title: 'Invisible pour votre banque',
              desc: "Contrairement à une demande de crédit formelle, notre diagnostic n'est pas inscrit dans les bases de données bancaires. Aucun impact sur votre dossier.",
            },
          ].map(feat => (
            <div class="card hover:shadow-card-md transition-shadow duration-200">
              <div class="text-2xl mb-3">{feat.icon}</div>
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">{feat.title}</h3>
              <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{feat.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Social proof / stats -->
    <section class="py-14 bg-gray-50 dark:bg-slate-800/50 border-y border-gray-100 dark:border-slate-800 transition-colors duration-200">
      <div class="container-main">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center max-w-2xl mx-auto">
          {[
            { value: '35%', label: 'Taux d\'endettement max', sub: 'Règle HCSF en vigueur' },
            { value: '25 ans', label: 'Durée maximale', sub: 'Pour la plupart des banques' },
            { value: '10%', label: 'Apport minimum', sub: 'Recommandé par les banques' },
          ].map(stat => (
            <div>
              <div class="text-3xl font-black text-gray-900 dark:text-white">{stat.value}</div>
              <div class="text-sm font-semibold text-gray-700 dark:text-slate-300 mt-1">{stat.label}</div>
              <div class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">{stat.sub}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-white dark:bg-slate-900 transition-colors duration-200">
      <div class="container-main max-w-2xl">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Questions fréquentes</h2>
          <p class="text-gray-500 dark:text-slate-400 mt-2">Tout ce que vous devez savoir avant de commencer.</p>
        </div>

        <div class="space-y-3">
          {[
            {
              q: 'Est-ce que mon diagnostic influence l\'attribution du prêt ?',
              a: "Non. DossierPrêt est un outil d'analyse pédagogique indépendant. Il n'a aucun lien avec les banques et n'apparaît pas dans les bases de données bancaires.",
            },
            {
              q: 'Est-ce que vous voyez mes informations bancaires ?',
              a: "Non. Vous saisissez vous-même vos données et elles ne sont pas stockées ni transmises. Votre diagnostic reste entièrement confidentiel.",
            },
            {
              q: 'Mon résultat est-il garanti ?',
              a: "Non. Il s'agit d'une simulation basée sur des critères standards. Les décisions bancaires réelles dépendent de nombreux autres facteurs propres à chaque établissement.",
            },
            {
              q: 'Puis-je annuler mon abonnement ?',
              a: "Le plan Premium est un accès unique. Il n'y a pas d'abonnement pour ce plan. Le plan Pro peut être annulé à tout moment depuis votre espace client.",
            },
            {
              q: 'Quelle est la différence avec un simulateur de prêt ?',
              a: "Un simulateur de prêt calcule des mensualités. DossierPrêt analyse votre profil bancaire pour identifier les risques de refus — pas le montant que vous pouvez emprunter.",
            },
          ].map((faq, i) => (
            <details class="group card p-0 overflow-hidden">
              <summary class="flex items-center justify-between p-5 cursor-pointer list-none">
                <span class="text-sm font-medium text-gray-900 dark:text-white">{faq.q}</span>
                <svg class="w-4 h-4 text-gray-400 transition-transform duration-200 group-open:rotate-180 flex-shrink-0 ml-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="px-5 pb-5">
                <p class="text-sm text-gray-500 dark:text-slate-400 leading-relaxed">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="py-16 bg-gray-900 text-white">
      <div class="container-main text-center">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">Obtenez votre analyse complète maintenant</h2>
        <p class="text-gray-400 text-lg mb-8 max-w-xl mx-auto">
          Un rapport complet sur votre profil emprunteur, des actions concrètes pour l'améliorer, un accès immédiat.
        </p>
        <a href="/diagnostic" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-gray-900 font-semibold text-sm rounded-xl hover:bg-gray-100 transition-colors">
          Accéder à mon diagnostic complet
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <p class="text-xs text-gray-500 mt-4">Paiement sécurisé · Accès immédiat · Sans abonnement</p>
      </div>
    </section>

    <Footer />
  </div>
</BaseLayout>
